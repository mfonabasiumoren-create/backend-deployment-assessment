# Application
PORT=8080

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
MONGO_URI=mongodb://root:CHANGE_ME_TO_A_STRONG_PASSWORD@mongodb:27017/?authSource=admin&replicaSet=rs0&directConnection=true
DB_NAME=much_todo_db

# Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION_HOURS=72

# Caching
ENABLE_CACHE=false
REDIS_ADDR=redis:6379
